# Copia este archivo a .env.local y completa tus datos
# PERSISTENCIA=memoria  -> corre sin base de datos (datos de ejemplo, se borran al reiniciar)
# PERSISTENCIA=mysql    -> usa MySQL con las variables DB_*
PERSISTENCIA=mysql
PORT=3001
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
