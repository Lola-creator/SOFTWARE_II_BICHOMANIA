{
  "name": "bichomania-backend",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pdfkit": "^0.17.2"
  },
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "start:local": "cross-env ENV_FILE=.env.local node index.js",
    "start:memoria": "cross-env PERSISTENCIA=memoria node index.js",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-junit": "^16.0.0",
    "serve": "^14.2.8"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/pruebas_funcionales_"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
