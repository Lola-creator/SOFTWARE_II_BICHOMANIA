const { ErrorCredenciales, ErrorNoAutorizado } = require("../dominio/errores");

// Devuelve el id del cliente a partir del token (req.usuario), nunca de la URL ni del body.
// El middleware de autenticación deja req.usuario = { id, rol }.
function idClienteAutenticado(req) {
    if (!req.usuario) {
        throw new ErrorCredenciales("Debes iniciar sesión");
    }
    if (req.usuario.rol !== "cliente") {
        throw new ErrorNoAutorizado("Esta operación es solo para clientes");
    }
    return req.usuario.id;
}

module.exports = { idClienteAutenticado };
